generator client {
  provider = "prisma-client-js"
  //Iska matlab Prisma ko JavaScript/TypeScript ke liye Prisma Client generate karna hai... iske baad hame await prisma.user.findMany() se crud operations kr skte hai
}

datasource db {
  provider = "postgresql"       //jo database use kr rha hai uska naam
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

model User {
  id        String   @id @default(uuid())  //yha @id ek primary key hai
  name      String
  email     String   @unique        //email should be unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
}