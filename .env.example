# Database connection string (PostgreSQL)
# For local Docker Compose: points to the 'postgres' container service
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/hostel_mess?schema=public"

# Test Database connection string (Separate DB for automated tests)
# Note: Test runner fails fast if this is missing or identical to DATABASE_URL to protect dev data
TEST_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/hostel_mess_test?schema=public"

# Application Port
PORT=3000

# Authentication JWT Secrets (Local fake secrets)
JWT_SECRET="local_dev_jwt_secret_key_fake_12345"
JWT_REFRESH_SECRET="local_dev_jwt_refresh_secret_key_fake_12345"

# Redis connection string (for local Docker Compose: points to 'redis' container service)
REDIS_URL="redis://redis:6379"

# Kitchen Worker Configuration
KITCHEN_PREP_SECONDS=5
# For testing only: set to true to simulate worker cooking failure
SIMULATE_WORKER_FAILURE=false

# Socket.io & Web CORS Configuration
CORS_ORIGIN="*"

# Redis Caching & Rate Limiting Configuration
MENU_CACHE_TTL_SECONDS=60
ORDER_RATE_LIMIT_MAX=5
ORDER_RATE_LIMIT_WINDOW_SECONDS=60

# Order Transaction Timeout Configuration (in milliseconds)
ORDER_TX_MAX_WAIT_MS=5000
ORDER_TX_TIMEOUT_MS=10000
