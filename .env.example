# Database connection string (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Test Database connection string (Separate Neon branch for automated tests)
# Note: Test runner fails fast if this is missing or identical to DATABASE_URL to protect dev data
TEST_DATABASE_URL="postgresql://user:password@test-branch-host/dbname?sslmode=require"

# Application Port
PORT=3000

# Authentication JWT Secrets
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

REDIS_URL=redis://localhost:6379

# Kitchen Worker Configuration
KITCHEN_PREP_SECONDS=10
# For testing only: set to true to simulate worker cooking failure
SIMULATE_WORKER_FAILURE=false

# Socket.io & Web CORS Configuration
CORS_ORIGIN="*"

# Step 7: Redis Caching & Rate Limiting Configuration
MENU_CACHE_TTL_SECONDS=60
ORDER_RATE_LIMIT_MAX=5
ORDER_RATE_LIMIT_WINDOW_SECONDS=60

# Order Transaction Timeout Configuration (in milliseconds)
ORDER_TX_MAX_WAIT_MS=5000
ORDER_TX_TIMEOUT_MS=10000
